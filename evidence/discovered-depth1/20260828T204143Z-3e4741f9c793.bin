		(function () {
			function setupAccordionSecondaryNav() {
				var $menuContainer = $('#secondaryNav');

				$menuContainer.find('*[id^="SideItem"]').each(function () {
					var ids = $('[id="' + this.id + '"]');
					if (ids.length > 1)
