            <script>
        var meetings = [];
        var featuredReports = [];
        function addMeeting(id,name,date) {
            document.getElementById('upcomingMeetings').innerHTML += '<div class="listbox-item">' +
                date + ' - <a href="/meetings?meeting=' + id + '">' + name + '</a></div>';
        }
        function addFeatured(id,name,date,fdate,featured) {
            if (id > '') {
                document.getElementById('featuredReports').innerHTML += '<div class="listbox-item">' +
                    date + ' - <a target="_blank" rel="noopener noreferrer" href="/downloadReport.php?id=' + id + '">' + name + (featured ? '&#127775;' : '') + '</a></div>';
            }
            if (featured) {
                document.getElementById('featuredReportsHead').textContent = " Featured & Early Released Reports";
            }
        }
        function getUpcomingMeetings() {
            var xhttp = new XMLHttpRequest();
            xhttp.onreadystatechange = function() {
                if (this.readyState == 4 && this.status == 200) {
                    var parsed = JSON.parse(this.responseText);
                    for(var item in parsed){
                        meetings.push(parsed[item]);
                        addMeeting(parsed[item][0],parsed[item][1],parsed[item][2]);
                    }
                }
            };
            xhttp.open("GET", "api.php?fn=getExtendedUpcoming", true);
            xhttp.send();
        }
        function getFeatured() {
            var xhttp = new XMLHttpRequest();
            xhttp.onreadystatechange = function() {
                if (this.readyState == 4 && this.status == 200) {
                    var parsed = JSON.parse(this.responseText);
                    for(var item in parsed){
                        featuredReports.push(parsed[item]);
                        addFeatured(parsed[item][0],parsed[item][1],parsed[item][2],parsed[item][3],parsed[item][4]);
                    }
                }
            };
            xhttp.open("GET", "api.php?fn=getFeatured", true);
            xhttp.send();
        }
        window.onload = function() {
            getUpcomingMeetings();
            getFeatured();
        }
    </script>
